<mjml>
  <mj-head>
    <mj-title>Confirm your email</mj-title>
    <mj-preview>Time-sensitive verification link. Expires in {{expire_minutes}} minutes.</mj-preview>

    <mj-font name="BlackOpsOne" href="https://fonts.googleapis.com/css2?family=Black+Ops+One&display=swap" />

    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" />
      <mj-button font-size="16px" font-weight="700" border-radius="6px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>

    <!-- No inline="inline" here -->
    <mj-style>
      .heading { font-family:"BlackOpsOne", system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important; }
      .link { color:#0ea5e9 !important; text-decoration:underline !important; }
      @media (prefers-color-scheme: dark) {
        .dark-card { background:#0b0b0c !important; }
        .dark-text { color:#ffffff !important; }
        .muted { color:#e7e7e7 !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f7">

    <!-- top branding -->
    <mj-section padding="24px 0 0 0">
      <mj-column>
        <mj-image alt="welcome branding" src="https://placehold.co/600x120" width="600px" />
      </mj-column>
    </mj-section>

    <!-- main content (dark card) -->
    <mj-wrapper background-color="#18181b" css-class="dark-card">

      <!-- heading -->
      <mj-section padding="28px 28px 0 28px" background-color="#18181b">
        <mj-column>
          <mj-text align="center" color="#fffbeb" font-size="28px" css-class="heading" padding="0 0 8px 0">
            confirm your email soldier
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- CTA -->
      <mj-section padding="16px 28px 0 28px" background-color="#18181b">
        <mj-column>
          <mj-button
            href="{{verify_url}}"
            align="center"
            width="240px"
            inner-padding="12px 20px"
            background-color="#059669"
            color="#ffffff"
            border-radius="6px">
            verify now
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- expires -->
      <mj-section padding="20px 28px 0 28px" background-color="#18181b">
        <mj-column>
          <mj-text align="center" color="#dc2626" css-class="heading" padding="0 0 6px 0">
            time sensitive
          </mj-text>
          <mj-text align="center" color="#ffffff" padding="0">
            link expires in {{expire_minutes}} minutes
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- explanation -->
      <mj-section padding="24px 28px 28px 28px" background-color="#18181b">
        <mj-column>
          <mj-text align="center" color="#e4e4e7" css-class="heading" padding="0 0 8px 0">
            mission briefing
          </mj-text>
          <mj-text align="center" color="#ffffff" padding="0">
            Your email was used on the web site Battle Houston. You must verify it to continue.
            If that wasn't you, you can ignore this email; otherwise
            <a class="link" href="{{verify_url}}">click this link</a> to verify.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- footer image -->
    <mj-section>
      <mj-column>
        <mj-image alt="footer branding" src="https://placehold.co/600x150" width="600px" />
      </mj-column>
    </mj-section>

    <!-- legal -->
    <mj-section background-color="#ffffff" padding="8px 16px 24px 16px">
      <mj-column>
        <mj-text align="center" color="#000000" font-size="13px" padding="4px 0">THIS IS AN AUTOMATATED EMAIL</mj-text>
        <mj-text align="center" color="#000000" font-size="13px" padding="4px 0">DO NOT REPLY</mj-text>
        <mj-text align="center" color="#000000" font-size="13px" padding="4px 0">&copy;2025 Battle Houston</mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>